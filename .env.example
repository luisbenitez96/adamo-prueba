# Copia este archivo como `.env` si quieres cambiar algo.
# Con Docker Compose los valores por defecto ya funcionan, no hace falta tocar nada.

# --- API ---
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://mongo:27017/adamo
APP_URL=http://localhost:8080
TRUST_PROXY=true
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN_MINUTES=60
COOKIE_SECURE=false
TEMP_PASSWORD_TTL_MINUTES=15

# --- Correo (por defecto Mailpit, la bandeja de pruebas de Docker Compose) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AdamoServices <no-reply@adamo.local>"
