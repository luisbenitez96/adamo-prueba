# Configuración para ejecutar SIN Docker (desarrollo local).
# Copia este archivo como `.env` en la raíz del proyecto.
# Con Docker Compose NO hace falta: ya trae todo configurado.

# --- API ---
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/adamo
APP_URL=http://localhost:5173
TRUST_PROXY=false
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN_MINUTES=60
COOKIE_SECURE=false
TEMP_PASSWORD_TTL_MINUTES=15

# --- Correo (Mailpit: bandeja de pruebas que arranca con Docker) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AdamoServices <no-reply@adamo.local>"

# --- Solo Docker Compose (opcionales: descomenta si un puerto está ocupado) ---
# WEB_PORT=8080
# MAILPIT_PORT=8025
# JWT_SECRET=otro-secreto-de-al-menos-32-caracteres
